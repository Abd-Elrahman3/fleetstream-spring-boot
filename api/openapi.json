{
  "openapi": "3.1.0",
  "info": {
    "title": "FleetStream Target API",
    "version": "1.0.0",
    "description": "Target contract; implementation is intentionally unfinished. Markdown rules define details and additional failure cases."
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
