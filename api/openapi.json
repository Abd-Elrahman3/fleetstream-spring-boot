    "/api/v1/devices/{deviceId}/events": {
      "get": {
        "operationId": "get_api_v1_devices_deviceId_events",
        "summary": "200 text/event-stream; 410 expired cursor; 503 connection cap",
        "description": "bearer owner; optional Last-Event-ID; see docs/API_REQUIREMENTS.md for rule-level behavior.",
        "parameters": [
          {
            "name": "deviceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Last-Event-ID",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[0-9]+$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "200 text/event-stream; 410 expired cursor; 503 connection cap",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "SSE frames: id, event, data; heartbeat comment every 15 seconds."
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or authorization failure",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Invalid request or authorization failure",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Invalid request or authorization failure",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "410": {
            "description": "200 text/event-stream; 410 expired cursor; 503 connection cap",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "200 text/event-stream; 410 expired cursor; 503 connection cap",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/devices/{deviceId}/geofences": {
      "post": {
        "operationId": "post_api_v1_devices_deviceId_geofences",
        "summary": "201 Geofence",
        "description": "{centerLatitude,centerLongitude,radiusMeters}; bearer owner; see docs/API_REQUIREMENTS.md for rule-level behavior.",
        "parameters": [
          {
            "name": "deviceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "201 Geofence",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeofenceView"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or authorization failure",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Invalid request or authorization failure",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Invalid request or authorization failure",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "centerLatitude": {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                  },
                  "centerLongitude": {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  },
                  "radiusMeters": {
                    "type": "number",
                    "minimum": 10,
                    "maximum": 100000
                  }
                },
                "required": [
                  "centerLatitude",
                  "centerLongitude",
                  "radiusMeters"
                ]
              }
            }
          }
        }
      }
    },
