                }
              }
            }
          },
          "403": {
            "description": "101; 401 invalid ticket; 403 origin; messages {type,sequence,payload}",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": []
      }
    }
