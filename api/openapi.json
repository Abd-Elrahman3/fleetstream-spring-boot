  "paths": {
    "/api/v1/telemetry/batches": {
      "post": {
        "operationId": "post_api_v1_telemetry_batches",
        "summary": "202 {receiptId,acceptedCount}; 400 invalid; 409 conflict; 413 oversized; 503 storage",
        "description": "{points:[TelemetryPoint]}; bearer telemetry:write; see docs/API_REQUIREMENTS.md for rule-level behavior.",
        "parameters": [],
        "responses": {
          "202": {
            "description": "202 {receiptId,acceptedCount}; 400 invalid; 409 conflict; 413 oversized; 503 storage",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestionReceipt"
                }
              }
            }
          },
          "400": {
            "description": "202 {receiptId,acceptedCount}; 400 invalid; 409 conflict; 413 oversized; 503 storage",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Invalid request or authorization failure",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Invalid request or authorization failure",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "202 {receiptId,acceptedCount}; 400 invalid; 409 conflict; 413 oversized; 503 storage",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "413": {
            "description": "202 {receiptId,acceptedCount}; 400 invalid; 409 conflict; 413 oversized; 503 storage",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "202 {receiptId,acceptedCount}; 400 invalid; 409 conflict; 413 oversized; 503 storage",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "points": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 500,
                    "items": {
                      "$ref": "#/components/schemas/TelemetryPoint"
                    }
                  }
                },
                "required": [
                  "points"
                ]
              }
            }
          }
        }
      }
    },
