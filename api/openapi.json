    "/ws/devices/{deviceId}": {
      "get": {
        "operationId": "get_ws_devices_deviceId",
        "summary": "101; 401 invalid ticket; 403 origin; messages {type,sequence,payload}",
        "description": "upgrade WebSocket; single-use ticket; see docs/API_REQUIREMENTS.md for rule-level behavior.",
        "parameters": [
          {
            "name": "deviceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "ticket",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "One-use short-lived ticket, never a bearer JWT."
          },
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "101": {
            "description": "101; 401 invalid ticket; 403 origin; messages {type,sequence,payload}"
          },
          "400": {
            "description": "Invalid request or authorization failure",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "101; 401 invalid ticket; 403 origin; messages {type,sequence,payload}",
            "content": {
              "application/problem+json": {
                "schema": {
